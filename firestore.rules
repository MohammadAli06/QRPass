rules_version = '2';

// QR Pass - deny everything by default.
//
// Public verification never touches Firestore directly: it goes through the
// Next.js server, which uses the Admin SDK (Admin bypasses these rules).
// The admin UI signs in with Firebase Auth, so any authenticated user may
// read and write. There is no public sign-up; admins are provisioned with
// `npm run create-admin`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /qrs/{token} {
      allow read, write: if request.auth != null;

      match /scans/{scanId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
