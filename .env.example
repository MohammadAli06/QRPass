# ---------------------------------------------------------------------------
# Firebase Web SDK (safe to expose to the browser)
# Firebase console > Project settings > General > Your apps > Web app config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Username -> email mapping for email/password auth.
# A login with username "alice" becomes alice@<this domain>.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=qrpass.local

# Absolute base URL used when building QR codes (no trailing slash).
# In development this falls back to window.location.origin when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to hide the "Powered by QR Pass" footer on public verify pages.
NEXT_PUBLIC_HIDE_BRANDING=false

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only - NEVER expose these with a NEXT_PUBLIC prefix)
# Firebase console > Project settings > Service accounts > Generate new key
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value from the service account JSON, keeping the quotes
# and the literal \n sequences. Escaped newlines are converted automatically.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
